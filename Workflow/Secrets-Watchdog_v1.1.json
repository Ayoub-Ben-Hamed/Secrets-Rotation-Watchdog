      "parameters": {
        "jsCode": "// Flags are deterministic functions of the classified data.computed HERE, once, in one write.\nconst creds = $input.all().map(i => i.json);\nconst now = new Date().toISOString();\n\nfor (const c of creds) {\n  if (c.should_notify) {\n    c.notify_sent = true;\n    c.last_notified_status = c.status;\n    c.last_notified_at = now;\n  }\n  if (c.should_escalate) {\n    c.escalated_to_admin = true;\n    c.escalation_level = c.escalation_tier;\n    c.revocation_flagged = c.escalation_tier === 3;\n    c.last_escalated_at = now;\n  }\n}\n\ncreds.sort((a, b) => a.id.localeCompare(b.id));\nconst json = JSON.stringify(creds, null, 2);\nconst prepared = await this.helpers.prepareBinaryData(\n  Buffer.from(json, 'utf8'), 'mock_credentials.json', 'application/json'\n);\n\n// Auditing Part\nconst audit = creds.map(c => ({ timestamp: now, run_id: $execution.id,\n  credential_id: c.id, credential_name: c.name,\n  event: c.should_escalate ? 'escalate' : c.should_notify ? 'notify' : 'scan',\n  actor: 'watchdog', escalation_level: c.escalation_level ?? 0, result: 'success' }));\n\nconst auditPrepared = await this.helpers.prepareBinaryData(\n  Buffer.from(JSON.stringify(audit, null, 2), 'utf8'), 'audit_log.json', 'application/json'\n);\n\nreturn [{ json: { records_written: creds.length }, binary: { data: prepared, audit: auditPrepared } }];"
      },
