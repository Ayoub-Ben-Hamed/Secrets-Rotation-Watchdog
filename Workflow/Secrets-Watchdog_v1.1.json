    {
      "parameters": {
        "jsCode": "// ===== Classify credentials — v3: owner lane + escalation lane =====\nconst WARN_30 = 30, SOON_7 = 7;           // owner-notification windows\nconst ESC_1 = 3, ESC_2 = 7, ESC_3 = 14;   // escalation tiers (days since expiry)\n\nconst today = $now.startOf('day');\nlet creds = $input.all().map(i => i.json);\nif (creds.length === 1 && Array.isArray(creds[0]?.data)) creds = creds[0].data;\n\nconst results = [];\nfor (const c of creds) {\n  const expiry = c?.expiry_date ? DateTime.fromISO(String(c.expiry_date)) : null;\n\n  if (!expiry || !expiry.isValid) {\n    results.push({ ...c, days_left: null, days_since_expiry: null, status: 'unknown',\n      escalation_tier: 0, should_notify: false, should_escalate: false,\n      note: 'expiry_date missing or invalid — fix metadata' });\n    continue;\n  }\n\n  const daysLeft = Math.round(expiry.startOf('day').diff(today,'milliseconds').milliseconds/86400000);\n  const dse = Math.max(0, -daysLeft);                 // days since expiry (0 while valid)\n\n  // ---- Lane 1: owner notification (unchanged logic from v2) ----\n  let status;\n  if (daysLeft <= 0)            status = 'expired';\n  else if (daysLeft <= SOON_7)  status = 'expiring_soon';\n  else if (daysLeft <= WARN_30) status = 'warning';\n  else                          status = 'ok';\n  const shouldNotify = (status !== 'ok' && status !== 'unknown')\n                    && (c.last_notified_status ?? null) !== status;\n\n  // ---- Lane 2: escalation (NEW — pure time-based target tier) ----\n  let tier = 0;\n  if      (dse >= ESC_3) tier = 3;\n  else if (dse >= ESC_2) tier = 2;\n  else if (dse >= ESC_1) tier = 1;\n\n  const storedLevel = c.escalation_level ?? 0;\n  const shouldEscalate = tier >= 1 && c.notify_sent === true && tier > storedLevel;\n\n  const next = { ...c, days_left: daysLeft, days_since_expiry: dse, status,\n                 escalation_tier: tier, should_notify: shouldNotify, should_escalate: shouldEscalate };\n\n  // Rotation = new lifecycle: clear BOTH lanes' memory (audit lives in exec history)\n  if (status === 'ok') {\n    next.notify_sent = false;      next.last_notified_status = null;\n    next.escalated_to_admin = false; next.escalation_level = 0;\n    next.revocation_flagged = false;\n  }\n  results.push(next);\n}\nreturn results.map(json => ({ json }));"
      },
      "type": "n8n-nodes-base.code",
