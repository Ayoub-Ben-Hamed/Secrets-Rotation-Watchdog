        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"attachments\": [{\n    \"color\": \"#B91C1C\",\n    \"blocks\": [\n      { \"type\": \"header\", \"text\": { \"type\": \"plain_text\", \"text\": \"🚨 Credential EXPIRED — admin escalation\" } },\n      { \"type\": \"section\", \"fields\": [\n        { \"type\": \"mrkdwn\", \"text\": \"*Credential*\\n{{ $json.name }}\" },\n        { \"type\": \"mrkdwn\", \"text\": \"*ID / Type*\\n{{ $json.id }} · {{ $json.type }}\" },\n        { \"type\": \"mrkdwn\", \"text\": \"*Owner*\\n{{ $json.owner_email }}\" },\n        { \"type\": \"mrkdwn\", \"text\": \"*Expired*\\n{{ $json.expiry_date }} ({{ Math.abs($json.days_left) }} days overdue)\" }\n      ]},\n      { \"type\": \"section\", \"text\": { \"type\": \"mrkdwn\",\n        \"text\": \"Owner has been notified and no rotation was recorded. Please verify rotation or disable this credential.\" } },\n      { \"type\": \"context\", \"elements\": [ { \"type\": \"mrkdwn\",\n        \"text\": \"Secrets Rotation Watchdog • automated alert • this is the expiry escalation path\" } ] }\n    ]\n  }]\n}",
        "options": {}
