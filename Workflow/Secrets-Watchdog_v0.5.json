      "id": "25e13182-e3bd-467e-a09f-aa94d49c7589",
      "name": "HTTP Request",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const WARN_30 = 30, SOON_7 = 7;\nconst today = $now.startOf('day');\n\nlet creds = $input.all().map(i => i.json);\nif (creds.length === 1 && Array.isArray(creds[0]?.data)) creds = creds[0].data;\n\nconst results = [];\nfor (const c of creds) {\n  const expiry = c?.expiry_date ? DateTime.fromISO(String(c.expiry_date)) : null;\n  if (!expiry || !expiry.isValid) {\n    results.push({ ...c, days_left: null, status: 'unknown', escalation_level: 1,\n      should_notify: false, note: 'expiry_date missing or invalid — fix metadata' });\n    continue;\n  }\n  const daysLeft = Math.round(expiry.startOf('day').diff(today,'milliseconds').milliseconds/86400000);\n  let status, esc;\n  if (daysLeft <= 0)            { status = 'expired';       esc = 2; }\n  else if (daysLeft <= SOON_7)  { status = 'expiring_soon'; esc = 1; }\n  else if (daysLeft <= WARN_30) { status = 'warning';       esc = 1; }\n  else                          { status = 'ok';            esc = 0; }\n\n  // DEDUP GATE: notify only on first contact or severity escalation\n  const lastNotified = c.last_notified_status ?? null;\n  const shouldNotify = (status !== 'ok' && status !== 'unknown') && lastNotified !== status;\n\n  const next = { ...c, days_left: daysLeft, status, escalation_level: esc, should_notify: shouldNotify };\n\n  // Self-healing reset: rotation moved the credential back to ok → clear notification memory.\n  // (escalated_to_admin is intentionally KEPT as audit evidence; rotation clears it in Module 4.)\n  if (status === 'ok') { next.notify_sent = false; next.last_notified_status = null; }\n\n  results.push(next);\n}\nreturn results.map(json => ({ json }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
